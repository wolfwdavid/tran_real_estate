{
	"name": "extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "wxt prepare || echo ''",
		"dev": "wxt",
		"build": "wxt build",
		"zip": "wxt zip",
		"check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"icons": "node scripts/make-icons.mjs",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"e2e": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/fraunces": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "1.45.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tran/brand": "workspace:*",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "4.1.12",
		"@wxt-dev/module-svelte": "2.0.5",
		"axe-core": "4.13.0",
		"happy-dom": "21.0.4",
		"playwright": "1.63.0",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"typescript": "~6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "2.2.1",
		"wxt": "0.21.4"
	}
}
