{
	"name": "extension",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "wxt prepare || echo ''",
		"dev": "wxt",
		"build": "wxt build",
		"zip": "wxt zip",
		"check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"icons": "node scripts/make-icons.mjs",
		"test:browser": "vitest run --config vitest.browser.config.ts",
		"e2e": "playwright test",
		"capture:store": "playwright test --config playwright.capture.config.ts"
	},
	"devDependencies": {
		"@fontsource-variable/fraunces": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@lucide/svelte": "1.73.0",
		"@playwright/test": "1.65.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tran/brand": "workspace:*",
		"@types/node": "^24.19.2",
		"@vitest/browser-playwright": "5.1.0",
		"@wxt-dev/module-svelte": "2.0.5",
		"axe-core": "4.14.1",
		"happy-dom": "21.0.4",
		"playwright": "1.65.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "~6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0",
		"vitest-browser-svelte": "3.1.0",
		"wxt": "0.21.5"
	}
}
