#!/bin/bash
# Runs the three repeat-each chunks one after another (Playwright's web server binds fixed ports).
S="$(dirname "$0")"
bash "$S/repeat-run.sh" A app-notice.spec.ts settings-backup.spec.ts settings-keys.spec.ts investor/autofill.spec.ts
a=$?
bash "$S/repeat-run.sh" B investor/buybox.spec.ts agent-inquire.spec.ts csp.spec.ts renter-saved.spec.ts
b=$?
bash "$S/repeat-run.sh" C guide.spec.ts agent-contact.spec.ts agent-followup.spec.ts renter-journey.spec.ts
c=$?
echo "chain done: A=$a B=$b C=$c at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
