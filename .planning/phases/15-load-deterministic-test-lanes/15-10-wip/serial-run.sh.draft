#!/bin/bash
# Usage: serial-run.sh  -> three consecutive `pnpm vitest run --project "*-serial"` runs, serial-1..3.log
set -u
cd "$(git rev-parse --show-toplevel)" || exit 9
for n in 1 2 3; do
  LOG=".tools/test-evidence/serial-$n.log"
  echo "start=$(date -u +%Y-%m-%dT%H:%M:%SZ) head=$(git rev-parse HEAD)" > "$LOG"
  echo '$ pnpm vitest run --project "*-serial"' >> "$LOG"
  MSYS_NO_PATHCONV=1 VITE_CONFIG_NATIVE_IGNORE_WARNING=true corepack.cmd pnpm vitest run --project "*-serial" >> "$LOG" 2>&1
  code=$?
  echo "exit=$code" >> "$LOG"
  echo "end=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$LOG"
done
