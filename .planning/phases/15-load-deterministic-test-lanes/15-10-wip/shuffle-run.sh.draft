#!/bin/bash
# Usage: shuffle-run.sh  -> one `pnpm test:unit` with shuffled files + tests and a recorded seed
set -u
cd "$(git rev-parse --show-toplevel)" || exit 9
LOG=.tools/test-evidence/shuffle.log
SEED=$(date +%s)
echo "seed=$SEED" > "$LOG"
echo "start=$(date -u +%Y-%m-%dT%H:%M:%SZ) head=$(git rev-parse HEAD)" >> "$LOG"
echo "\$ pnpm test:unit --sequence.shuffle.files --sequence.shuffle.tests --sequence.seed=$SEED" >> "$LOG"
MSYS_NO_PATHCONV=1 VITE_CONFIG_NATIVE_IGNORE_WARNING=true corepack.cmd pnpm test:unit --sequence.shuffle.files --sequence.shuffle.tests --sequence.seed=$SEED >> "$LOG" 2>&1
code=$?
echo "exit=$code" >> "$LOG"
echo "end=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$LOG"
exit $code
