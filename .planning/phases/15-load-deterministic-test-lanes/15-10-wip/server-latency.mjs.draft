// D1: serve-pages latency for one small chunk, idle vs under the 16-thread burner, with and without
// four concurrent service-worker-style precache storms (each: every build file, 6 sockets like Chromium).
// Usage: node server-latency.mjs [repo] [serverScript]
import { spawn } from 'node:child_process';
import { readdirSync, statSync, existsSync, rmSync, writeFileSync } from 'node:fs';
import http from 'node:http';
import { join, relative } from 'node:path';

const REPO = process.argv[2] ?? process.cwd();
const SERVER = process.argv[3] ?? join(REPO, 'scripts/serve-pages.mjs');
const PORT = 4373;
const BUILD = join(REPO, 'apps/web/build');
const PROBE = '/_app/immutable/chunks/CKat51EL.js';
const STOP = join(REPO, '.tools/test-evidence/diag-stop');

function walk(dir, out = []) {
	for (const n of readdirSync(dir)) {
		const p = join(dir, n);
		if (statSync(p).isDirectory()) walk(p, out);
		else out.push('/' + relative(BUILD, p).replace(/\\/g, '/'));
	}
	return out;
}
const URLS = walk(BUILD);

function get(path, agent) {
	return new Promise((resolve) => {
		const t = performance.now();
		const req = http.get({ host: '127.0.0.1', port: PORT, path, agent }, (res) => {
			res.resume();
			res.on('end', () => resolve({ ms: performance.now() - t, status: res.statusCode }));
		});
		req.on('error', () => resolve({ ms: performance.now() - t, status: -1 }));
	});
}

async function storm() {
	const agent = new http.Agent({ keepAlive: false, maxSockets: 6 });
	let i = 0;
	await Promise.all(
		Array.from({ length: 6 }, async () => {
			while (i < URLS.length) await get(URLS[i++], agent);
		})
	);
	agent.destroy();
}

function stats(xs) {
	const a = [...xs].sort((p, q) => p - q);
	const q = (f) => a[Math.min(a.length - 1, Math.floor(f * a.length))].toFixed(1);
	return `n=${a.length} p50=${q(0.5)} p90=${q(0.9)} max=${a[a.length - 1].toFixed(1)} ms`;
}

async function probeFor(ms, label, withStorms) {
	const agent = new http.Agent({ keepAlive: false });
	const samples = [];
	const end = performance.now() + ms;
	const storms = withStorms ? Promise.all([storm(), storm(), storm(), storm()]) : Promise.resolve();
	const t0 = performance.now();
	while (performance.now() < end) {
		samples.push((await get(PROBE, agent)).ms);
		await new Promise((r) => setTimeout(r, 50));
	}
	await storms;
	const stormMs = (performance.now() - t0).toFixed(0);
	console.log(`${label}: probe ${stats(samples)}${withStorms ? ` (4 storms x ${URLS.length} files done in ${stormMs} ms)` : ''}`);
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const server = spawn(process.execPath, [SERVER], {
	env: { ...process.env, E2E_PORT_ROOT: String(PORT), E2E_PORT_SUB: '4374', E2E_PORT_ATTACKER: '4375', E2E_PORT_CONFIGURED: '4376' },
	stdio: 'ignore'
});
await sleep(1500);
console.log(`server: ${relative(REPO, SERVER)}  build files: ${URLS.length}`);
await probeFor(4000, 'idle, no storm', false);
await probeFor(12000, 'idle, 4 storms', true);
if (existsSync(STOP)) rmSync(STOP);
const burn = spawn(process.execPath, [join(REPO, 'scripts/cpu-burn.mjs'), '--threads', '16', '--stop-file', STOP, '--max-seconds', '300'], { stdio: 'ignore' });
await sleep(4000);
await probeFor(4000, 'burner 16, no storm', false);
await probeFor(20000, 'burner 16, 4 storms', true);
writeFileSync(STOP, '');
await new Promise((r) => burn.on('exit', r));
server.kill();
console.log('done ' + new Date().toISOString());
